# PostgreSQL connection string
# Replace 'yourpassword' with your PostgreSQL password
# Default PostgreSQL username is 'postgres' and default port is 5432
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/meteocity

# RapidAPI key for Meteostat weather data
# Get yours free at https://rapidapi.com/meteostat/api/meteostat
RAPIDAPI_KEY=your_rapidapi_key_here

# Flask secret key — can leave as-is or change to any random string
JWT_SECRET_KEY=some-secret-key-123
